# Atende-IA — exemplo de configuracao
# Copia para .env e preenche. O .env NUNCA vai para o git.

# ---------------------------------------------------------------- Base de dados
# Com docker-compose, PG_HOST fica "db" (o nome do servico).
# A correr localmente contra uma base externa, poe o IP/hostname real.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=atende
PG_PASSWORD=substitui_isto
PG_DATABASE=atende_db

# ---------------------------------------------------------------- Ollama (LLM)
OLLAMA_URL=http://127.0.0.1:11434
ATENDE_LLM=qwen2.5-coder:7b
ATENDE_EMBED=nomic-embed-text:latest

# ---------------------------------------------------------------- Seguranca
# Gera com:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Minimo 32 caracteres — a config recusa menos.
ATENDE_JWT_SECRET=

# ---------------------------------------------------------------- Fila de tarefas
# memoria | redis
ATENDE_FILA=memoria
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------- Comportamento
ATENDE_AMBIENTE=dev
# Limiar de escalonamento calibrado por medicao (ver README).
# Fronteira medida: 0.604 (irrelevante) vs 0.648 (relevante).
ATENDE_LIMIAR=0.63

# ---------------------------------------------------------------- Demo (Streamlit)
ATENDE_API_URL=http://127.0.0.1:8100
ATENDE_USUARIO=demo
ATENDE_SENHA=substitui_isto
